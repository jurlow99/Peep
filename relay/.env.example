# Peep relay configuration — copy to .env and fill in.

# Port the relay API listens on (localhost only; the Cloudflare Tunnel fronts it).
RELAY_PORT=8088

# Shared secret. Generate a strong one:  openssl rand -hex 32
# The SAME value must be stored as a Supabase secret (RELAY_TOKEN) used by the
# relay-control edge function. NEVER put this in the web frontend.
RELAY_TOKEN=

# Where desired feed state is persisted so relays resume after reboot (root-only file).
RELAY_STATE_FILE=/var/lib/peep-relay/relay-state.json
