# Copy to .env.local and fill in. .env.local is gitignored — it does NOT sync
# between machines, so every new machine needs this set up by hand.
#
# Point these at the DEV Supabase project for local work. If you point them at
# prod, the purple DEV badge in the bottom-left disappears — no badge means you
# are editing the real database.

VITE_SUPABASE_URL=https://<your-dev-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-dev-anon-key>
