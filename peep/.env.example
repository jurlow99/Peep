# Copy to .env.local and fill in. .env.local is gitignored — it does NOT sync
# between machines, so every new machine needs this set up by hand.
#
# All three values are REQUIRED. The app refuses to start (throws in the browser)
# if VITE_PEEP_ENV is missing, if the URL points at one of the old/lost Supabase
# projects, or if a secret key is used instead of the public one.
#
# Local work uses the DEV project (FARRIS). The FARRIS splash/badge only appears
# when VITE_PEEP_ENV=development — no badge means production.

VITE_PEEP_ENV=development
VITE_SUPABASE_URL=https://cuwdyedmmnpklufduaho.supabase.co
VITE_SUPABASE_ANON_KEY=<dev-publishable-or-anon-key>
